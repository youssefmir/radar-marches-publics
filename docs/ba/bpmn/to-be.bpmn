<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_to-be" targetNamespace="https://github.com/youssefmir/radar-marches-publics">
  <bpmn:collaboration id="collab"><bpmn:participant id="pool" name="TO-BE — Veille outillée par Radar Marchés Publics" processRef="proc"/></bpmn:collaboration>
  <bpmn:process id="proc" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="lane0" name="Dirigeant"><bpmn:flowNodeRef>g1</bpmn:flowNodeRef><bpmn:flowNodeRef>e1</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="lane1" name="Chargé d'affaires"><bpmn:flowNodeRef>s</bpmn:flowNodeRef><bpmn:flowNodeRef>t1</bpmn:flowNodeRef><bpmn:flowNodeRef>t2</bpmn:flowNodeRef><bpmn:flowNodeRef>e2</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="lane2" name="Radar (système)"><bpmn:flowNodeRef>a1</bpmn:flowNodeRef><bpmn:flowNodeRef>a2</bpmn:flowNodeRef><bpmn:flowNodeRef>a3</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Profil défini une fois"/>
    <bpmn:serviceTask id="a1" name="Collecter les avis ouverts (BOAMP)"/>
    <bpmn:serviceTask id="a2" name="Classer : score hybride expliqué"/>
    <bpmn:serviceTask id="a3" name="Qualifier : grille go/no-go + historique DECP"/>
    <bpmn:userTask id="t1" name="Revoir les 30 premiers avis"/>
    <bpmn:exclusiveGateway id="g1" name="Go ?"/>
    <bpmn:userTask id="t2" name="Monter le dossier (lot ciblé)"/>
    <bpmn:endEvent id="e1" name="Écarté, motif tracé"/>
    <bpmn:endEvent id="e2" name="Offre déposée"/>
    <bpmn:sequenceFlow id="f0" sourceRef="s" targetRef="a1"/>
    <bpmn:sequenceFlow id="f1" sourceRef="a1" targetRef="a2"/>
    <bpmn:sequenceFlow id="f2" sourceRef="a2" targetRef="a3"/>
    <bpmn:sequenceFlow id="f3" sourceRef="a3" targetRef="t1"/>
    <bpmn:sequenceFlow id="f4" sourceRef="t1" targetRef="g1"/>
    <bpmn:sequenceFlow id="f5" sourceRef="g1" targetRef="t2" name="go"/>
    <bpmn:sequenceFlow id="f6" sourceRef="g1" targetRef="e1" name="no-go"/>
    <bpmn:sequenceFlow id="f7" sourceRef="t2" targetRef="e2"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diag"><bpmndi:BPMNPlane id="plane" bpmnElement="collab">
    <bpmndi:BPMNShape id="pool_di" bpmnElement="pool" isHorizontal="true"><dc:Bounds x="60" y="40" width="1470" height="450"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="lane0_di" bpmnElement="lane0" isHorizontal="true"><dc:Bounds x="90" y="40" width="1440" height="150"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="lane1_di" bpmnElement="lane1" isHorizontal="true"><dc:Bounds x="90" y="190" width="1440" height="150"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="lane2_di" bpmnElement="lane2" isHorizontal="true"><dc:Bounds x="90" y="340" width="1440" height="150"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="s_di" bpmnElement="s"><dc:Bounds x="197" y="247" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="a1_di" bpmnElement="a1"><dc:Bounds x="320" y="383" width="130" height="64"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="a2_di" bpmnElement="a2"><dc:Bounds x="490" y="383" width="130" height="64"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="a3_di" bpmnElement="a3"><dc:Bounds x="660" y="383" width="130" height="64"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="830" y="233" width="130" height="64"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="g1_di" bpmnElement="g1"><dc:Bounds x="1040" y="90" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="t2_di" bpmnElement="t2"><dc:Bounds x="1170" y="233" width="130" height="64"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="e1_di" bpmnElement="e1"><dc:Bounds x="1217" y="97" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="e2_di" bpmnElement="e2"><dc:Bounds x="1387" y="247" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="f0_di" bpmnElement="f0"><di:waypoint x="215" y="283"/><di:waypoint x="215" y="415"/><di:waypoint x="320" y="415"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="450" y="415"/><di:waypoint x="490" y="415"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="620" y="415"/><di:waypoint x="660" y="415"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="725" y="383"/><di:waypoint x="725" y="265"/><di:waypoint x="830" y="265"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="895" y="233"/><di:waypoint x="895" y="115"/><di:waypoint x="1040" y="115"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="1065" y="140"/><di:waypoint x="1065" y="265"/><di:waypoint x="1170" y="265"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="1090" y="115"/><di:waypoint x="1217" y="115"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="1300" y="265"/><di:waypoint x="1387" y="265"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
